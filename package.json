{
  "name": "opencode-go-dashboard",
  "version": "1.0.0",
  "description": "Self-hosted dashboard for monitoring OpenCode Go quota across multiple accounts",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "build:client": "vite build",
    "build": "npm run build:client",
    "dev": "vite",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply opencode-go-dashboard --local",
    "db:migrate:remote": "wrangler d1 migrations apply opencode-go-dashboard --remote"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250617.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.8.3",
    "vite": "^7.2.0",
    "wrangler": "^4.20.0"
  }
}